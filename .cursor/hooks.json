{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-approval.sh",
        "matcher": "harness"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/check-on-stop.sh",
        "timeout": 120,
        "loop_limit": 1
      }
    ]
  }
}
